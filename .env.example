# ==============================================================================
# BioSanctuary OS - Variables de Entorno de Ejemplo
# ==============================================================================

# Conexiones a Supabase (PostgreSQL - Schema-per-Tenant)
# DIRECT_URL: Cadena de conexión directa a Supabase (puerto 5432) para DDL y conmutación de search_path
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST_OR_POOLER]:5432/postgres"

# DATABASE_URL: Cadena de conexión al pooler de Supabase (puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres"

# Redis para Idempotencia y Rate Limiting (Contenedor local Docker)
REDIS_URL="redis://:redis_password@localhost:6379"

# Variables de entorno base
NODE_ENV=development
PORT=3000

